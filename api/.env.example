# Copy to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed if something cross-origin ever POSTs with a session cookie (e.g. Django admin
# accessed through a proxy on a different origin). The native Swift app uses Token auth, which
# isn't subject to CSRF, so this can usually stay empty. Prod: https://YOUR_DOMAIN_HERE if needed.
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=family_appily
POSTGRES_USER=family_appily
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Shared secret external automation presents, either in the X-Ingestion-Key
# header or as a ?key= query param (Apify webhooks can only set the URL).
INGESTION_API_KEY=change-me-to-a-long-random-string

# Required for the Apify webhook to read a finished run's dataset — an
# unauthenticated GET returns 403 despite what Apify's docs imply.
APIFY_TOKEN=apify_api_your_token_here
